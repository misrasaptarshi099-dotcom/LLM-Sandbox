# === LLM Sandbox — Environment Configuration ===
# Copy this file to .env and fill in values.
# NEVER commit .env — it is in .gitignore.

# --- Database (Railway provides DATABASE_URL automatically) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_sandbox

# --- Redis (Railway provides REDIS_URL automatically) ---
REDIS_URL=redis://localhost:6379/0

# --- Encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
AES_256_GCM_SECRET=CHANGE_ME_generate_a_64_hex_char_secret_key_here

# --- Auth (development only — replace with real auth in production) ---
DEV_AUTH_TOKEN=dev-token

# --- LLM Provider (optional — FakeLLMProvider used when not set) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Rate Limiting ---
RATE_LIMIT_PER_USER_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
